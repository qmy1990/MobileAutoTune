set(MAT_ORT_ROOT "${CMAKE_CURRENT_SOURCE_DIR}/.tools/ort" CACHE PATH "Prepared ONNX Runtime directory")
if(ANDROID)
 add_library(mat_onnxruntime SHARED IMPORTED)
else()
 add_library(mat_onnxruntime UNKNOWN IMPORTED)
endif()
if(ANDROID)
 set(MAT_ORT_LIBRARY "${MAT_ORT_ROOT}/android/jni/${ANDROID_ABI}/libonnxruntime.so")
elseif(CMAKE_SYSTEM_NAME STREQUAL "iOS")
 if(CMAKE_OSX_SYSROOT MATCHES "iphonesimulator")
  set(MAT_ORT_SLICE ios-arm64_x86_64-simulator)
 else()
  set(MAT_ORT_SLICE ios-arm64)
 endif()
 set(MAT_ORT_LIBRARY "${MAT_ORT_ROOT}/ios/onnxruntime.xcframework/${MAT_ORT_SLICE}/onnxruntime.framework/onnxruntime")
elseif(APPLE)
 set(MAT_ORT_LIBRARY "${MAT_ORT_ROOT}/ios/onnxruntime.xcframework/macos-arm64_x86_64/onnxruntime.framework/Versions/A/onnxruntime")
else()
 find_library(MAT_ORT_LIBRARY onnxruntime REQUIRED)
endif()
if(NOT EXISTS "${MAT_ORT_LIBRARY}")
 message(FATAL_ERROR "Prepare key analysis dependencies: python3 scripts/prepare_key_analysis.py --platform all")
endif()
set_target_properties(mat_onnxruntime PROPERTIES IMPORTED_LOCATION "${MAT_ORT_LIBRARY}")
add_library(mobileautotune_key STATIC src/key_audio.cpp src/key_runtime.cpp src/key_sha256.cpp)
target_include_directories(mobileautotune_key PUBLIC include PRIVATE
 third_party/onnxruntime/include third_party/signalsmith-linear)
target_link_libraries(mobileautotune_key PUBLIC mobileautotune mat_onnxruntime)
target_compile_options(mobileautotune_key PRIVATE -O3 -Wall -Wextra)
if(ANDROID)
 target_link_libraries(mobileautotune_key PUBLIC android log)
endif()
if(APPLE)
 target_link_libraries(mobileautotune_key PUBLIC "-framework Foundation" "-framework CoreML" "-framework Accelerate")
endif()
if(MAT_BUILD_TOOLS AND NOT ANDROID AND NOT CMAKE_SYSTEM_NAME STREQUAL "iOS")
 add_executable(mat_key_analyze tools/key_analyze.cpp)
 target_link_libraries(mat_key_analyze PRIVATE mobileautotune_key)
 add_executable(mat_key_frontend_probe tools/key_frontend_probe.cpp)
 target_link_libraries(mat_key_frontend_probe PRIVATE mobileautotune_key)
endif()
install(TARGETS mobileautotune_key ARCHIVE DESTINATION lib)
